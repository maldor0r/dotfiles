# shellcheck shell=bash
# ==========================================================
# Custom Bash configuration
# Author: maldor0r
# ==========================================================

# ----------------------------------------------------------
# Termux / minimal shells: ensure USER is set (ble.sh requires it)
# ----------------------------------------------------------

if [ -z "${USER:-}" ] && command -v id &> /dev/null; then
    export USER="$(id -un)"
fi

# ble.sh warns when the locale is the degenerate "C" locale (common on
# Termux). NOTE: setting LANG only helps if that locale is actually
# installed; the robust fix is `pkg install -y libandroid-support` plus
# generating the locale. So here we only ensure a locale is picked when
# one is unset and looks installed — otherwise leave it alone.

# ----------------------------------------------------------
# User-local binaries (~/.local/bin) on PATH
# ----------------------------------------------------------

if [ -d "$HOME/.local/bin" ]; then
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ;;
        *) export PATH="$HOME/.local/bin:$PATH" ;;
    esac
fi

# ----------------------------------------------------------
# lsd aliases (with fallback if lsd is not installed)
# ----------------------------------------------------------

if command -v lsd &> /dev/null; then
    alias ls='lsd --group-directories-first'          # basic, no hidden
    alias la='lsd -a --group-directories-first'        # basic, with hidden
    alias ll='lsd -l --group-directories-first'        # long, no hidden
    alias lla='lsd -la --group-directories-first'      # long, with hidden
    alias lt='lsd --tree --depth 3 --group-directories-first'   # tree, no hidden
    alias lta='lsd -a --tree --depth 3 --group-directories-first' # tree, with hidden
    alias llt='lsd -l --tree --depth 3 --group-directories-first' # tree + long, no hidden
    alias llta='lsd -la --tree --depth 3 --group-directories-first' # tree + long, with hidden
else
    # Fallback aliases using standard ls
    alias ls='ls --color=auto'
    alias la='ls -A --color=auto'
    alias ll='ls -l --color=auto'
    alias lla='ls -lA --color=auto'
fi

# ----------------------------------------------------------
# starship prompt
# ----------------------------------------------------------

if command -v starship &> /dev/null; then
    eval "$(starship init bash)"
fi
