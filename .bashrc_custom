# shellcheck shell=bash
# ==========================================================
# Custom Bash configuration
# Author: maldor0r
# ==========================================================

# ----------------------------------------------------------
# Termux / minimal shells: ensure USER is set (ble.sh requires it)
# ----------------------------------------------------------

if [ -z "${USER:-}" ] && command -v id &> /dev/null; then
    _dotfiles_user="$(id -un)"
    export USER="${_dotfiles_user}"
fi

# ble.sh and other tools warn when the locale is the degenerate "C" locale
# (common on Termux). Force Bionic's native UTF-8 C locale at runtime so the
# warning goes away; a robust alternative for missing locale data is
# `pkg install -y libandroid-support` plus generating a locale.
if [ -n "${PREFIX:-}" ] && [ -z "${LC_ALL:-}" ]; then
    export LC_ALL='C.UTF-8' LANG='C.UTF-8' LC_CTYPE='C.UTF-8'
fi

# ----------------------------------------------------------
# User-local binaries (~/.local/bin) on PATH
# ----------------------------------------------------------

if [ -d "$HOME/.local/bin" ]; then
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ;;
        *) export PATH="$HOME/.local/bin:$PATH" ;;
    esac
fi

# ----------------------------------------------------------
# lsd aliases (with fallback if lsd is not installed)
#   Defined via a helper so plain/rich mode can flip icon behavior
#   without touching ~/.config/lsd/config.yaml.
#   Rich:  lsd --group-directories-first
#   Plain: lsd --icon never --group-directories-first
# ----------------------------------------------------------

_dotfiles_lsd_set() {
    local icon="$1"   # "" for rich, "--icon never " for plain; inserted right after lsd
    # shellcheck disable=SC2139  # expand the mode string when (re)defining
    alias ls="lsd ${icon}--group-directories-first"
    # shellcheck disable=SC2139
    alias la="lsd ${icon}-a --group-directories-first"
    # shellcheck disable=SC2139
    alias ll="lsd ${icon}-l --group-directories-first"
    # shellcheck disable=SC2139
    alias lla="lsd ${icon}-la --group-directories-first"
    # shellcheck disable=SC2139
    alias lt="lsd ${icon}--tree --depth 3 --group-directories-first"
    # shellcheck disable=SC2139
    alias lta="lsd ${icon}-a --tree --depth 3 --group-directories-first"
    # shellcheck disable=SC2139
    alias llt="lsd ${icon}-l --tree --depth 3 --group-directories-first"
    # shellcheck disable=SC2139
    alias llta="lsd ${icon}-la --tree --depth 3 --group-directories-first"
}

if command -v lsd &> /dev/null; then
    _dotfiles_lsd_set ""
else
    # Fallback aliases using standard ls
    alias ls='ls --color=auto'
    alias la='ls -A --color=auto'
    alias ll='ls -l --color=auto'
    alias lla='ls -lA --color=auto'
fi

# ----------------------------------------------------------
# Safe file-operation defaults (interactive shells only)
#   Protect against accidental overwrites/deletions while learning.
#   Only affects interactive shells; scripts are untouched.
#   Bypass anytime with \cp, \mv, \rm, \ln or command cp/mv/rm/ln.
# ----------------------------------------------------------
alias cp='cp -i'   # confirm before overwriting an existing file
alias mv='mv -i'   # confirm before overwriting an existing file
alias rm='rm -I'   # confirm once for 3+ files or any recursive delete
alias ln='ln -i'   # confirm before unlinking/replacing a link

# ----------------------------------------------------------
# starship prompt
#   - rich:  Nerd Font / Powerline (graphical terminals)
#   - plain: ASCII separators, no Nerd glyphs (Linux virtual
#            consoles, or forced with DOTFILES_PLAIN=1)
# ----------------------------------------------------------

# Locate the plain config: the installed copy next to this file,
# falling back to the repo checkout.
_dotfiles_plain_cfg="$HOME/.config/dotfiles/starship-plain.toml"
if [ ! -f "$_dotfiles_plain_cfg" ]; then
    _dotfiles_dir_cfg="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
    _dotfiles_plain_cfg="$_dotfiles_dir_cfg/starship-plain.toml"
fi

# Automatic detection: plain mode on a real Linux virtual console
# (tty1/tty2/...) via $TTY or $TERM=linux, or forced by DOTFILES_PLAIN.
_dotfiles_use_plain=0
if [ -n "${DOTFILES_PLAIN:-}" ]; then
    _dotfiles_use_plain=1
elif [[ $TTY == /dev/tty[0-9]* ]] || [[ $TERM == linux* ]]; then
    _dotfiles_use_plain=1
elif command -v tty >/dev/null 2>&1 && [[ $(tty 2>/dev/null) == /dev/tty[0-9]* ]]; then
    _dotfiles_use_plain=1
fi

# Apply plain mode to lsd first (independent of StarShip). In rich mode
# the default aliases (set above) are already correct, so only re-set here
# when plain is active.
if [ "$_dotfiles_use_plain" = 1 ] && command -v lsd &> /dev/null; then
    _dotfiles_lsd_set "--icon never "
fi

if command -v starship &> /dev/null; then
    if [ "$_dotfiles_use_plain" = 1 ]; then
        export STARSHIP_CONFIG="$_dotfiles_plain_cfg"
    else
        unset STARSHIP_CONFIG
    fi
    eval "$(starship init bash)"
fi
unset _dotfiles_use_plain _dotfiles_plain_cfg _dotfiles_dir_cfg

# Temporary prompt toggles (current shell/session only).
# Takes effect on the next prompt (press Enter). No new shell needed.
# Switches BOTH Starship and lsd icon behavior.
dotfiles-plain() {
    export DOTFILES_PLAIN=1
    local cfg="$HOME/.config/dotfiles/starship-plain.toml"
    [ -f "$cfg" ] || cfg="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/starship-plain.toml"
    command -v lsd &> /dev/null && _dotfiles_lsd_set "--icon never "
    command -v starship &> /dev/null || return 0
    export STARSHIP_CONFIG="$cfg"
    eval "$(starship init bash)"
}
dotfiles-rich() {
    unset DOTFILES_PLAIN STARSHIP_CONFIG
    command -v lsd &> /dev/null && _dotfiles_lsd_set ""
    command -v starship &> /dev/null || return 0
    eval "$(starship init bash)"
}

# ----------------------------------------------------------
# fastfetch (system info on interactive shells only)
#   Runs exactly once per interactive, real-TTY shell. Guarded so it
#   never fires from non-interactive contexts (scripts, command
#   substitution, pipes, CI) - those set $- without the interactive
#   flag, and stdout is not a TTY in redirected subshells.
# ----------------------------------------------------------

if [[ $- == *i* ]] && [ -t 1 ] && command -v fastfetch &> /dev/null; then
    fastfetch
fi
