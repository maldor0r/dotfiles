// fastfetch configuration — dotfiles managed template
//
// Pastel-powerline palette, matching the starship theme in
// config/starship/starship.toml:
//   #9A348E purple, #DA627D rose, #FCA17D orange,
//   #86BBD8 blue, #06969A teal, #33658A indigo
//
// On Linux virtual consoles (plain mode) Nerd Font glyphs are unavailable;
// the logo is rendered with ASCII art there. The shell integration only
// runs fastfetch on an interactive TTY, so this is mostly a display theme.

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " ➜",
        "color": {
            "keys": "#9A348E",
            "colon": "#33658A"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{#FCA17D}┌─────────────────────────────┐"
        },
        {
            "type": "title",
            "format": "{#DA627D} {user-name}@{host-name}"
        },
        {
            "type": "title",
            "format": "{#DA627D}──────────────────────────────"
        },
        {
            "key": "    OS",
            "type": "os"
        },
        {
            "key": " KERNEL",
            "type": "kernel"
        },
        {
            "key": "   UPTM",
            "type": "uptime"
        },
        {
            "key": "    PKG",
            "type": "packages"
        },
        {
            "key": "   SHELL",
            "type": "shell"
        },
        {
            "key": "    TERM",
            "type": "terminal"
        },
        {
            "key": "      DE",
            "type": "de"
        },
        {
            "key": "      WM",
            "type": "wm"
        },
        {
            "type": "gap"
        },
        {
            "key": "     CPU",
            "type": "cpu",
            "temp": true
        },
        {
            "key": "     GPU",
            "type": "gpu"
        },
        {
            "key": "    MEM",
            "type": "memory"
        },
        {
            "key": "    DISK",
            "type": "disk"
        },
        {
            "key": "   LOCAL",
            "type": "localip",
            "showIpv4": true,
            "showIpv6": false
        },
        {
            "type": "title",
            "format": "{#33658A}──────────────────────────────"
        },
        {
            "type": "title",
            "format": "{#33658A}└─ {#06969A}fastfetch"
        }
    ]
}